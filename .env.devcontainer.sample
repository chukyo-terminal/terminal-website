# NextAuth
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET

# DB
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SSL=false

# Discord
DISCORD_FORM_WEBHOOK=YOUR_WEBHOOK_URL

# Cloudflare Turnstile
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA # Always passes
#NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=2x00000000000000000000AB # Always fails
#NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000BB # Always passes (invisible)
#NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=2x00000000000000000000BB # Always fails (invisible)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=3x00000000000000000000FF # Forces interactive challenge
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA # Always passes validation
#CLOUDFLARE_TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA # Always fails validation
#CLOUDFLARE_TURNSTILE_SECRET_KEY=3x0000000000000000000000000000000AA # Returns "token already spent" error
# 記事の評価・コメント用（本番ではウィジェットのモードを「Non-interactive」に設定したキーを使用する）
CLOUDFLARE_TURNSTILE_NON_INTERACTIVE_SITE_KEY=1x00000000000000000000AA # Always passes
CLOUDFLARE_TURNSTILE_NON_INTERACTIVE_SECRET_KEY=1x0000000000000000000000000000000AA # Always passes validation

# Mail（Dev Container の Mailpit に送信する。届いたメールは http://localhost:8025 で確認できる）
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Terminal (開発) <contact@terminal-website.test>"

# 受信メール（Dev Container の GreenMail から、問い合わせ者からの返信を IMAP で受信する。パスワードは何でもよい）
IMAP_HOST=imap
IMAP_PORT=3143
IMAP_SECURE=false
IMAP_USER=contact@terminal-website.test
IMAP_PASSWORD=dev
IMAP_POLL_INTERVAL=15

# 公開予約（予約した日時を過ぎた記事を自動で公開する間隔。秒。0 の場合は自動で公開しない）
SCHEDULED_PUBLISH_INTERVAL=60

# Valkey（Dev Container の valkey サービス）
VALKEY_URL=valkey://valkey:6379/0

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000/
