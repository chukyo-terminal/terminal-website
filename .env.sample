# NextAuth
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET

# DB
DATABASE_HOST=DB_HOST
DATABASE_PORT=DB_PORT
DATABASE_USER=DB_USER
DATABASE_PASSWORD=DB_PASSWORD
DATABASE_NAME=DB_NAME
DATABASE_SSL=true

# Discord
DISCORD_FORM_WEBHOOK=YOUR_WEBHOOK_URL

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY
CLOUDFLARE_TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY
# 記事の評価・コメント用（ウィジェットのモードを「Non-interactive」に設定したもの。実行時に読み込まれる）
CLOUDFLARE_TURNSTILE_NON_INTERACTIVE_SITE_KEY=YOUR_CLOUDFLARE_TURNSTILE_NON_INTERACTIVE_SITE_KEY
CLOUDFLARE_TURNSTILE_NON_INTERACTIVE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_NON_INTERACTIVE_SECRET_KEY

# Mail（お問い合わせフォームの入力用 URL と、お問い合わせへの返信の送信に使用する。SMTP_HOST と MAIL_FROM を設定しない場合は、お問い合わせを受け付けられず、返信も送信できない）
SMTP_HOST=SMTP_HOST
SMTP_PORT=587
# true の場合は接続時から TLS を使用する（ポート 465 など）。false の場合はサーバーが対応していれば STARTTLS で暗号化する
SMTP_SECURE=false
SMTP_USER=SMTP_USER
SMTP_PASSWORD=SMTP_PASSWORD
MAIL_FROM="Terminal <YOUR_MAIL_ADDRESS>"
# 問い合わせ者からの返信の宛先（送信元と異なる場合のみ設定する）
#MAIL_REPLY_TO=YOUR_REPLY_TO_ADDRESS

# 受信メール（問い合わせ者からの返信を IMAP で受信して記録する。IMAP_HOST と IMAP_USER を設定しない場合は記録しない）
# 返信先（MAIL_REPLY_TO、設定しない場合は MAIL_FROM）のアドレスに届いたメールを受信するメールボックスを指定する
IMAP_HOST=IMAP_HOST
IMAP_PORT=993
# false の場合は接続時には TLS を使用しない（サーバーが対応していれば STARTTLS で暗号化する）
IMAP_SECURE=true
IMAP_USER=IMAP_USER
IMAP_PASSWORD=IMAP_PASSWORD
IMAP_MAILBOX=INBOX
# 自動で確認する間隔（秒）。0 の場合は自動で確認しない（管理画面の「今すぐ確認」でのみ確認する）
IMAP_POLL_INTERVAL=60

# Valkey（お問い合わせフォームの入力用 URL などの一時的なデータを保存する。compose.yaml の valkey サービスを使用する場合はこのまま）
# TLS を使用する場合は valkeys://、認証する場合は valkey://ユーザー名:パスワード@ホスト:ポート/DB番号 の形式で指定する
VALKEY_URL=valkey://valkey:6379/0

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000/
